+import rescore as R, build_sheet as bs
+import pandas as pd
+RULES={'edge_floor':'20261020_1513','tally':'20261025_1601','market_move':'20261026_1311','stale':'20261027_1305'}  # slot veto, top-5: always
+def pkey(date,hh): return f"{date}_{hh if hh.isdigit() else '0000'}"
+def live(rule,key): return key>=RULES[rule]
+TAG={'tally':'tally ','market_move':'market move','stale':'stale lineup'}
+def score(passes):
+    out=[]
+    for date,hh,pf,gf in passes:
+        k=pkey(date,hh)
+        bs.EDGE_FLOOR=0.05 if live('edge_floor',k) else -1.0   # pre-floor passes: no 5-pt floor (top-5 then ranks the larger pool)
+        d=R.go([(date,hh,pf,gf)])
+        if d.empty: continue
+        keep=[]
+        for b in d.blockers.fillna(''):
+            bl=[x for x in b.split(' | ') if x and not any(x.startswith(t) and not live(r,k) for r,t in TAG.items())]
+            keep.append(' | '.join(bl))
+        d['blockers']=keep; d['makes_list']=d.blockers.eq(''); d['rules_key']=k
+        out.append(d)
+    bs.EDGE_FLOOR=0.05
+    return pd.concat(out,ignore_index=True) if out else pd.DataFrame()
